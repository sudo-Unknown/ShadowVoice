# Server Configuration
PORT=3050

# Owner Profile & Persona
OWNER_NAME=Smit
OWNER_ROLE=Software Engineer & Builder
OWNER_STATUS=Currently in deep focus / meetings. Available after 5:00 PM for urgent matters.
OWNER_BIO=Specializes in AI systems, full-stack software development, cybersecurity, and cloud automation.
OWNER_EMAIL=smit@example.com

# LLM Engine Provider: 'ollama' | 'groq' | 'openai'
LLM_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=cyber-coder:fast

# Optional Cloud Providers (Ultra-low latency for phone calls)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Twilio Telephony Settings (Optional - fill when connecting a real phone number)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VOICE=Polly.Matthew-Neural
TWILIO_LANGUAGE=en-US

# Instant Voicemail Alerts (Optional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...
